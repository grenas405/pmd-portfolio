{
  "name": "pmd-portfolio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Portfolio of Pedro M. Dominguez — pedromdominguez.dev, served by a Cloudflare Worker.",
  "scripts": {
    "build:client": "node scripts/build-client.mjs",
    "dev": "npm run build:client && wrangler dev",
    "types": "wrangler types",
    "typecheck": "npm run build:client && wrangler types && tsc --noEmit -p tsconfig.json && tsc --noEmit -p client/tsconfig.json",
    "test": "npm run build:client && vitest run",
    "check": "npm run typecheck && npm test",
    "deploy": "npm run check && wrangler deploy"
  },
  "dependencies": {
    "animejs": "4.5.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.9.0",
    "@fontsource-variable/archivo": "5.3.0",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "vitest": "4.1.12",
    "wrangler": "4.166.0"
  }
}
